table(column=(type=decimal updatewhereclause=yes name=qty dbname="qty")
 column=(type=decimal updatewhereclause=yes name=unit_cost dbname="unit_cost")
 retrieve="SELECT qty, unit_cost FROM invoice_lines WHERE billed = 1"
 )
